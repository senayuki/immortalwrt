		regmap = <0x0b>;
		offset = <0x00>;
		mask = <0x02>;
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupts = <0x01 0x0d 0x04 0x01 0x0e 0x04 0x01 0x0b 0x04 0x01 0x0a 0x04>;
	};

	pmu {
		compatible = "arm,armv8-pmuv3";
		interrupts = <0x01 0x07 0x08>;
	};

	psci {
		status = "okay";
		compatible = "arm,psci-1.0", "arm,psci-0.2";
		method = "smc";
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x00 0x80000000 0x00 0x80000000 0x20 0x80000000 0x07 0x80000000>;
	};

	memory-controller@1080000 {
		compatible = "fsl,qoriq-memory-controller";
		reg = <0x00 0x1080000 0x00 0x1000>;
		interrupts = <0x00 0x11 0x04>;
		little-endian;
	};

	memory-controller@1090000 {
		compatible = "fsl,qoriq-memory-controller";
		reg = <0x00 0x1090000 0x00 0x1000>;
		interrupts = <0x00 0x12 0x04>;
		little-endian;
	};

	sysclk {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x5f5e100>;
		clock-output-names = "sysclk";
		linux,phandle = <0x0c>;
		phandle = <0x0c>;
	};

	thermal-zones {
		cluster6-7 {
			polling-delay-passive = <1000>;
			polling-delay = <5000>;
			thermal-sensors = <0x12 0>;
			trips {
				cluster6_7_alert: cluster6-7-alert { temperature = <85000>; hysteresis = <2000>; type = "passive"; };
				cluster6_7_crit: cluster6-7-crit { temperature = <95000>; hysteresis = <2000>; type = "critical"; };
			};
			cooling-maps {
				map0 {
					trip = <&cluster6_7_alert>;
					cooling-device = <&{/cpus/cpu@0} 0xffffffff 0xffffffff>, <&{/cpus/cpu@1} 0xffffffff 0xffffffff>, <&{/cpus/cpu@100} 0xffffffff 0xffffffff>, <&{/cpus/cpu@101} 0xffffffff 0xffffffff>, <&{/cpus/cpu@200} 0xffffffff 0xffffffff>, <&{/cpus/cpu@201} 0xffffffff 0xffffffff>, <&{/cpus/cpu@300} 0xffffffff 0xffffffff>, <&{/cpus/cpu@301} 0xffffffff 0xffffffff>, <&{/cpus/cpu@400} 0xffffffff 0xffffffff>, <&{/cpus/cpu@401} 0xffffffff 0xffffffff>, <&{/cpus/cpu@500} 0xffffffff 0xffffffff>, <&{/cpus/cpu@501} 0xffffffff 0xffffffff>, <&{/cpus/cpu@600} 0xffffffff 0xffffffff>, <&{/cpus/cpu@601} 0xffffffff 0xffffffff>, <&{/cpus/cpu@700} 0xffffffff 0xffffffff>, <&{/cpus/cpu@701} 0xffffffff 0xffffffff>;
				};
			};
		};
		ddr-cluster5 { polling-delay-passive = <1000>; polling-delay = <5000>; thermal-sensors = <0x12 1>; trips { alert { temperature = <85000>; hysteresis = <2000>; type = "passive"; }; crit { temperature = <95000>; hysteresis = <2000>; type = "critical"; }; }; };
		wriop { polling-delay-passive = <1000>; polling-delay = <5000>; thermal-sensors = <0x12 2>; trips { alert { temperature = <85000>; hysteresis = <2000>; type = "passive"; }; crit { temperature = <95000>; hysteresis = <2000>; type = "critical"; }; }; };
		dce-qbman-hsio2 { polling-delay-passive = <1000>; polling-delay = <5000>; thermal-sensors = <0x12 3>; trips { alert { temperature = <85000>; hysteresis = <2000>; type = "passive"; }; crit { temperature = <95000>; hysteresis = <2000>; type = "critical"; }; }; };
		ccn-dpaa-tbu { polling-delay-passive = <1000>; polling-delay = <5000>; thermal-sensors = <0x12 4>; trips { alert { temperature = <85000>; hysteresis = <2000>; type = "passive"; }; crit { temperature = <95000>; hysteresis = <2000>; type = "critical"; }; }; };
		cluster4-hsio3 { polling-delay-passive = <1000>; polling-delay = <5000>; thermal-sensors = <0x12 5>; trips { alert { temperature = <85000>; hysteresis = <2000>; type = "passive"; }; crit { temperature = <95000>; hysteresis = <2000>; type = "critical"; }; }; };
		cluster2-3 { polling-delay-passive = <1000>; polling-delay = <5000>; thermal-sensors = <0x12 6>; trips { alert { temperature = <85000>; hysteresis = <2000>; type = "passive"; }; crit { temperature = <95000>; hysteresis = <2000>; type = "critical"; }; }; };
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		clocking@1300000 {
			compatible = "fsl,lx2160a-clockgen";
			reg = <0x00 0x1300000 0x00 0xa0000>;
			#clock-cells = <0x02>;
			clocks = <0x0c>;
			linux,phandle = <0x02>;
			phandle = <0x02>;
		};

		crypto@8000000 {
			compatible = "fsl,sec-v5.0", "fsl,sec-v4.0";
			fsl,sec-era = <0x0a>;
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			ranges = <0x00 0x00 0x8000000 0x100000>;
			reg = <0x00 0x8000000 0x00 0x100000>;
			interrupts = <0x00 0x8b 0x04>;
			dma-coherent;
			status = "okay";

			jr@10000 {
				compatible = "fsl,sec-v5.0-job-ring", "fsl,sec-v4.0-job-ring";
				reg = <0x10000 0x10000>;
				interrupts = <0x00 0x8c 0x04>;
			};

			jr@20000 {
				compatible = "fsl,sec-v5.0-job-ring", "fsl,sec-v4.0-job-ring";
				reg = <0x20000 0x10000>;
				interrupts = <0x00 0x8d 0x04>;
			};

			jr@30000 {
				compatible = "fsl,sec-v5.0-job-ring", "fsl,sec-v4.0-job-ring";
				reg = <0x30000 0x10000>;
				interrupts = <0x00 0x8e 0x04>;
			};

			jr@40000 {
				compatible = "fsl,sec-v5.0-job-ring", "fsl,sec-v4.0-job-ring";
				reg = <0x40000 0x10000>;
				interrupts = <0x00 0x8f 0x04>;
			};
		};

