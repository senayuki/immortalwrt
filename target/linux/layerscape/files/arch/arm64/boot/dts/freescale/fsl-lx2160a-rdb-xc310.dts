	interrupt-controller@6000000 {
		compatible = "arm,gic-v3";
		reg = <0x00 0x6000000 0x00 0x10000 0x00 0x6200000 0x00 0x200000 0x00 0xc0c0000 0x00 0x2000 0x00 0xc0d0000 0x00 0x1000 0x00 0xc0e0000 0x00 0x20000>;
		#interrupt-cells = <0x03>;
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		interrupt-controller;
		interrupts = <0x01 0x09 0x04>;
		linux,phandle = <0x01>;
		phandle = <0x01>;

