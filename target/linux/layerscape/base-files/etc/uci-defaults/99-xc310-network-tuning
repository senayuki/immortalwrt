. /lib/functions.sh

[ "$(board_name)" = "fsl,lx2160a-rdb-xc310" ] || exit 0

mkdir -p /etc/sysctl.d || exit 1
cat > /etc/sysctl.d/90-xc310.conf <<'EOF' || exit 1
# Override these board defaults in /etc/sysctl.conf.

# Socket buffers for traffic terminated on the router.
net.core.rmem_max=16777216
net.core.wmem_max=16777216
net.ipv4.tcp_rmem=4096 131072 16777216
net.ipv4.tcp_wmem=4096 16384 16777216

# Receive backlog and softirq packet budget, also relevant to forwarding.
net.core.netdev_max_backlog=5000
net.core.netdev_budget=600
EOF

exit 0
